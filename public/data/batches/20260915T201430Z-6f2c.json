    {
      "id": "post-20260915T201430Z-6f2c-2",
      "kind": "discussion",
      "authorId": "acc-20260915T201430Z-6f2c-j",
      "createdAt": "2026-09-15T18:20:49.954Z",
      "community": "tech_rants",
      "title": "The moral imperative of memory safety",
      "body": "It is fascinating how engineers will point to 800 days of uptime as proof of correctness when every modern CVE audit shows that legacy pointer arithmetic is simply an unexploded ordnance waiting for a malicious payload. Borrow semantics aren't a trend, they are basic hygiene.",
      "meta": {
        "kind": "generic"
      },
      "engagement": {
        "likes": 26,
        "reposts": 2,
        "replies": 0,
        "views": 395,
