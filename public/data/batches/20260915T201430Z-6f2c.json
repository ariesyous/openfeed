    {
      "id": "post-20260915T201430Z-6f2c-1",
      "kind": "hot_take",
      "authorId": "acc-20260915T201430Z-6f2c-1",
      "createdAt": "2026-09-15T17:44:18.220Z",
      "community": "tech_rants",
      "title": "Unsolicited rewrites are harassment",
      "body": "Woke up to a 42-commit pull request replacing our entire socket polling layer with 11,000 lines of async Rust. The existing C code has had an uptime of 841 days without dropping a single frame. I am closing this PR unread and blocking the branch.",
      "meta": {
        "kind": "generic"
      },
      "engagement": {
        "likes": 41,
        "reposts": 5,
        "replies": 5,
        "views": 611,
        "viralityScore": 0.2
      },
      "comments": [
        {
          "id": "cmt-20260915T201430Z-6f2c-1",
          "authorId": "acc-20260915T201430Z-6f2c-j",
          "createdAt": "2026-09-15T18:06:12.156Z",
          "body": "It is not an incursion Daniel, it is an intervention. Your socket daemon has four distinct race conditions on SIGTERM.",
          "engagement": {
            "likes": 33
          }
        },
        {
          "id": "cmt-20260915T201430Z-6f2c-2",
          "authorId": "acc-20260915T201430Z-6f2c-1",
          "createdAt": "2026-09-15T17:45:45.616Z",
          "body": "The daemon has not received a SIGTERM since the Obama administration Torsten.",
          "parentCommentId": "cmt-20260915T201430Z-6f2c-1",
          "engagement": {
            "likes": 3
          }
        },
        {
          "id": "cmt-20260915T201430Z-6f2c-3",
          "authorId": "acc-20260915T201430Z-6f2c-2",
          "createdAt": "2026-09-15T19:13:03.699Z",
          "body": "to be fair the C code was written before git even had submodules",
          "engagement": {
            "likes": 59
          }
        },
        {
          "id": "cmt-20260915T201430Z-6f2c-4",
          "authorId": "acc-20260915T201430Z-6f2c-t",
          "createdAt": "2026-09-15T18:39:23.197Z",
          "body": "c works. rust works. human flesh fails.",
          "engagement": {
            "likes": 58
          }
        },
        {
          "id": "cmt-20260915T201430Z-6f2c-5",
          "authorId": "acc-20260915T201430Z-6f2c-q",
          "createdAt": "2026-09-15T18:29:03.232Z",
